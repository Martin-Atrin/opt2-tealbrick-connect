{
  "name": "@opt2-tealbrick/connect",
  "version": "0.1.2",
  "private": true,
  "description": "Teal Brick Connect miniapp: Composio, MCP connectors, Tealbrick catalog, Channels. Built on the Miniapp SDK.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/ui/tsconfig.json",
    "lint": "biome check .",
    "test": "node --test 'test/**/*.test.ts'",
    "conformance": "tb-conformance app --start conformance.start.ts --manifest tealbrick.manifest.json --inputs conformance.inputs.json && node scripts/conformance.ts",
    "catalog:build": "node scripts/catalog-build.ts",
    "build": "vite build --config vite.config.ts"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@opt2-tealbrick/spec": "https://github.com/Martin-Atrin/opt2-tealbrick-specs/releases/download/spec-v0.1.2/opt2-tealbrick-spec-0.1.2.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@opt2-tealbrick/manifest": "https://github.com/Martin-Atrin/opt2-tealbrick-sdk/releases/download/manifest-v0.1.1/opt2-tealbrick-manifest-0.1.1.tgz",
    "@opt2-tealbrick/miniapp-sdk": "https://github.com/Martin-Atrin/opt2-tealbrick-sdk/releases/download/miniapp-sdk-v0.1.2/opt2-tealbrick-miniapp-sdk-0.1.2.tgz",
    "@opt2-tealbrick/ui": "https://github.com/Martin-Atrin/opt2-tealbrick-packages/releases/download/ui-v0.1.0/opt2-tealbrick-ui-0.1.0.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "@opt2-tealbrick/conformance": "https://github.com/Martin-Atrin/opt2-tealbrick-sdk/releases/download/conformance-v0.1.0/opt2-tealbrick-conformance-0.1.0.tgz"
  }
}
